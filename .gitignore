# Pastikan .gitignore sudah benar
cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment
.env
.env.local
.env.*.local

# Data (jangan upload file hasil processing)
data/uploads/*
data/outputs/*
!data/uploads/.gitkeep
!data/outputs/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Temporary
tmp/
temp/
*.tmp
*.pid
*.port

# Jupyter
.ipynb_checkpoints/

# Streamlit
.streamlit/

# Testing
.pytest_cache/
.coverage
htmlcov/

# OpenAI
openai_secret.json
EOF